 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Users' view (gateway)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "id": 1,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Requests per second by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (service) (rate(ftuni_http_requests_total{job=\"gateway\", service!=\"gateway\"}[10s]))",
     "legendFormat": "{{service}}",
     "refId": "A",
     "interval": "1s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Error ratio (5xx) by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "id": 3,
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (service) (rate(ftuni_http_requests_total{job=\"gateway\", service!=\"gateway\", status=~\"5..\"}[10s])) / sum by (service) (rate(ftuni_http_requests_total{job=\"gateway\", service!=\"gateway\"}[10s]))",
     "legendFormat": "{{service}}",
     "refId": "A",
     "interval": "1s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     },
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
